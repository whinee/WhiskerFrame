#!/usr/bin/env python3
"""
WhiskerFrame Cyberdeck Unified Management CLI (wf).

Lightweight, 53-column cyberdeck control tool and offline manual.
Hardware: Raspberry Pi Zero 2W + CYD (ESP32 + ILI9341 320x240 display).
"""

from __future__ import annotations

import argparse
import datetime
import importlib.util
import json
import os
import shutil
import subprocess
import sys
import textwrap
from importlib.machinery import SourceFileLoader
from pathlib import Path
from typing import Any

MAX_COLUMNS: int = 53
DEFAULT_WORKSPACE_FILE: str = "/tmp/whiskerframe_workspaces.json"  # noqa: S108

# --- Text Formatting Helpers ------------------------------------------------


def wrap_text(text: str, width: int = MAX_COLUMNS) -> list[str]:
    """Wrap multiline or long text strictly within width columns."""
    if not text:
        return [""]
    out: list[str] = []
    for line in text.splitlines():
        if len(line) <= width:
            out.append(line)
        else:
            out.extend(textwrap.wrap(line, width=width, break_long_words=True))
    return out


def print_bounded(*args: Any, sep: str = " ") -> None:
    """Print message with all lines strictly constrained to MAX_COLUMNS."""
    raw = sep.join(str(a) for a in args)
    for line in wrap_text(raw, MAX_COLUMNS):
        print(line)


