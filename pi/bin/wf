# Aliases for manual topics
MANUAL_ALIASES: dict[str, str] = {
    "keyboard": "kb",
    "keys": "kb",
    "cardkb": "kb",
    "wlan": "wifi",
    "network": "wifi",
    "sandbox": "demo",
    "guest": "demo",
