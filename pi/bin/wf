    "cyd": "terminal",
    "display": "terminal",
    "workspace": "workspaces",
    "ws": "workspaces",
    "sessions": "workspaces",
}


def cmd_man(args: list[str]) -> int:
    """Display offline manual topics."""
    if not args:
        print_bounded("=== WhiskerFrame Offline Manual ===")
        print_bounded("Available topics:")
        print_bounded("  kb          CardKB shortcuts & sticky Ctrl")
        print_bounded("  wifi        Wi-Fi network configuration")
        print_bounded("  demo        Demo sandbox & security limits")
        print_bounded("  terminal    CYD terminal & display engine")
        print_bounded("  workspaces  Multi-terminal workspace manager")
        print_bounded("")
        print_bounded("Usage: wf man <topic>")
        return 0

    topic_raw = args[0].lower().strip()
    topic = MANUAL_ALIASES.get(topic_raw, topic_raw)

    if topic in MANUAL_TOPICS:
        for line in MANUAL_TOPICS[topic].splitlines():
            print_bounded(line)
        return 0

    print_bounded(f"Error: Unknown manual topic '{topic_raw}'.")
    print_bounded("Available topics: kb, wifi, demo, terminal, workspaces")
    return 1


# --- Wi-Fi Re-use -----------------------------------------------------------


def _load_wifi_module() -> Any | None:
    """Load pi/bin/wifi dynamically if available."""
    candidates = [
        Path(__file__).resolve().parent / "wifi",
        Path("/usr/local/bin/wifi"),
        Path("/opt/cyd-display-link/pi/bin/wifi"),
    ]
    for p in candidates:
        if p.is_file():
            try:
                loader = SourceFileLoader("wifi_cli", str(p))
                spec = importlib.util.spec_from_loader("wifi_cli", loader)
                if spec and spec.loader:
                    mod = importlib.util.module_from_spec(spec)
                    loader.exec_module(mod)
                    return mod
            except Exception:
                continue
    return None


def cmd_wifi(args: list[str]) -> int:
    """Reuse pi/bin/wifi NetworkManager helper."""
    wifi_mod = _load_wifi_module()
    if wifi_mod is not None:
        try:
            return int(wifi_mod.main(args))
        except SystemExit as e:
            return int(e.code) if e.code is not None else 0

    # Subprocess fallback
    candidates = [
        Path(__file__).resolve().parent / "wifi",
        Path("/usr/local/bin/wifi"),
        Path("/opt/cyd-display-link/pi/bin/wifi"),
    ]
    for p in candidates:
        if p.is_file() and os.access(p, os.X_OK):
            proc = subprocess.run([str(p)] + args)
            return proc.returncode

    # If neither is found, check PATH
    wifi_in_path = shutil.which("wifi")
    if wifi_in_path:
        proc = subprocess.run([wifi_in_path] + args)
        return proc.returncode

    print_bounded("Error: Wi-Fi helper (pi/bin/wifi) not found.")
    return 1


# --- Demo & Art -------------------------------------------------------------


def print_builtin_demo_banner() -> int:
    """Print demo sandbox banner with live telemetry <= 53 columns."""
    print_bounded("=====================================================")
    print_bounded("       Whiskerframe Cyberdeck v0.1 Demo Sandbox      ")
    print_bounded("=====================================================")
    print_bounded("")
    print_bounded("Welcome, guest! Restricted kernel sandbox:")
    print_bounded(" - Network: 100% Isolated (nftables egress drop)")
    print_bounded(" - Memory: 64MB Cgroup Slice | CPU Quota: 50%")
    print_bounded(" - Execution Limit: 5s max / process (Reaper)")
    print_bounded(" - Filesystem: Ephemeral 8MB tmpfs (wiped on logout)")
    print_bounded("")
    print_bounded("--- Live Deck Telemetry ---")

    # Uptime
    uptime_str = "unknown"
    try:
        proc = subprocess.run(["uptime", "-p"], capture_output=True, text=True, check=False)
        if proc.returncode == 0 and proc.stdout.strip():
            uptime_str = proc.stdout.strip()
    except Exception:
        pass
    print_bounded(f"Uptime: {uptime_str}")

    # Power (INA219)
    status_file = Path("/run/battery_monitor/status.json")
    if status_file.is_file():
        try:
            data = json.loads(status_file.read_text())
            v = data.get("bus_voltage_v", 12.4)
            p = data.get("battery_percent", 95)
            print_bounded(f"Power: {v:.1f}V ({p:.0f}% battery)")
        except Exception:
            print_bounded("Power: 12.4V (95% battery)")
    else:
        print_bounded("Power: 12.4V (95% battery)")

    # Thermals
    thermal_file = Path("/sys/class/thermal/thermal_zone0/temp")
    if thermal_file.is_file():
        try:
            raw = int(thermal_file.read_text().strip())
            print_bounded(f"Thermals: {raw / 1000.0:.1f}°C")
        except Exception:
            print_bounded("Thermals: 60.0°C")
    else:
        print_bounded("Thermals: 60.0°C")

    # Memory
    try:
        proc = subprocess.run(["free", "-h"], capture_output=True, text=True, check=False)
        mem_avail = "200M"
        for line in proc.stdout.splitlines():
            if line.startswith("Mem:"):
                parts = line.split()
                if len(parts) >= 7:
                    mem_avail = parts[6]
        print_bounded(f"Memory Available: {mem_avail}")
    except Exception:
        print_bounded("Memory Available: 200M")

    print_bounded("")
    print_bounded("Try running safe commands, or type 'exit' to log out.")
    print_bounded("=====================================================")
    return 0


def cmd_demo_art(args: list[str]) -> int:
    """Display cyberdeck demo artwork."""
    print_bounded("=====================================================")
    print_bounded("       WhiskerFrame Cyberdeck v0.1 Art Gallery       ")
    print_bounded("=====================================================")
    print_bounded("")
    print_bounded("      /\\_/\\   ")
    print_bounded("     ( o.o )   \"WhiskerFrame CYD\"")
    print_bounded("      > ^ <    Art by Cess (CC BY-NC-ND)")
    print_bounded("     /     \\  ")
    print_bounded("    (  (..) )  320x240 ILI9341 RGB565")
    print_bounded("")
    print_bounded("Artwork Catalog:")
    print_bounded(" - cess/market: Lyra & Dreanne Christmas Market")
    print_bounded(" - cess/doodle: Lyra Cyberdeck Cat Doodle")
    print_bounded(" - splash/reboot: Goodbye Reboot (\"brb :3\")")
    print_bounded(" - splash/shutdown: Goodbye Shutdown (\"bai baiii!\")")
    print_bounded("")
    print_bounded("Format: 320x240 Little-Endian RGB565 (Opcode 0x05)")
    print_bounded("Wire Protocol: DRAW_IMAGE (Chunked rows <=1280B)")
    print_bounded("=====================================================")
    return 0


def cmd_demo(args: list[str]) -> int:
    """Execute demo subcommand or demo art."""
    if args and args[0] == "art":
        return cmd_demo_art(args[1:])

    # Check for executable demo script
    candidates = [
        Path(__file__).resolve().parent / "demo",
        Path("/usr/local/bin/demo"),
        Path("/opt/cyd-display-link/pi/bin/demo"),
    ]
    for p in candidates:
        if p.is_file() and os.access(p, os.X_OK):
            proc = subprocess.run([str(p)] + args, capture_output=True, text=True, check=False)
            for line in proc.stdout.splitlines():
                clean_line = line.replace("\033[H\033[2J\033[3J", "").strip("\r\n")
                if clean_line:
                    print_bounded(clean_line)
            return proc.returncode

    return print_builtin_demo_banner()


# --- Workspaces & Terminal Management ---------------------------------------


class WorkspaceManager:
    """Manage lightweight multi-session workspaces / terminals."""

    def __init__(self, state_path: str | Path | None = None) -> None:
        if state_path is None:
            state_path = os.environ.get("WF_WORKSPACE_FILE", DEFAULT_WORKSPACE_FILE)
        self.state_file = Path(state_path)

    def _load(self) -> dict[str, Any]:
        """Load state from disk or return clean initial state."""
        if self.state_file.is_file():
            try:
                data = json.loads(self.state_file.read_text())
                if isinstance(data, dict) and "workspaces" in data and "active" in data:
                    return data
            except Exception:
                pass

        # Default initial state
        initial = {
            "active": "main",
            "workspaces": [
                {
                    "id": 1,
                    "name": "main",
                    "created_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
                    "description": "Primary console workspace",
                }
            ],
        }
        self._save(initial)
        return initial

    def _save(self, data: dict[str, Any]) -> None:
        """Save state to disk."""
        try:
            self.state_file.parent.mkdir(parents=True, exist_ok=True)
            self.state_file.write_text(json.dumps(data, indent=2))
        except OSError:
            pass

    def list(self) -> int:
        """List all workspaces."""
        data = self._load()
        active = data.get("active", "main")
        workspaces = data.get("workspaces", [])

        print_bounded("=== Cyberdeck Workspaces ===")
        if not workspaces:
            print_bounded("No active workspaces.")
            return 0

        for ws in workspaces:
            ws_id = ws.get("id", "?")
            ws_name = ws.get("name", "unnamed")
            is_active = (ws_name == active) or (str(ws_id) == str(active))
            marker = "[*]" if is_active else "   "
            status = " (active)" if is_active else ""
            print_bounded(f"{marker} [{ws_id}] {ws_name}{status}")

        print_bounded(f"Total: {len(workspaces)} workspace(s)")
        return 0

    def new(self, name: str | None = None) -> int:
        """Create a new workspace."""
        data = self._load()
        workspaces: list[dict[str, Any]] = data.get("workspaces", [])

        existing_names = {ws.get("name") for ws in workspaces}
        existing_ids = {ws.get("id") for ws in workspaces if isinstance(ws.get("id"), int)}

        next_id = max(existing_ids, default=0) + 1

        if not name:
            name = f"ws-{next_id}"

        if name in existing_names:
            print_bounded(f"Error: Workspace '{name}' already exists.")
            return 1

        new_entry = {
            "id": next_id,
            "name": name,
            "created_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        }
        workspaces.append(new_entry)
        data["workspaces"] = workspaces
        self._save(data)

        # Notify tmux if running
        if shutil.which("tmux"):
            subprocess.run(["tmux", "new-session", "-d", "-s", name], capture_output=True, check=False)

        print_bounded(f"Created workspace '{name}' (id: {next_id}).")
        return 0

    def switch(self, target: str) -> int:
        """Switch active workspace focus."""
        if not target:
            print_bounded("Error: Workspace name or ID required.")
            return 1

        data = self._load()
        workspaces: list[dict[str, Any]] = data.get("workspaces", [])

        matched = None
        for ws in workspaces:
            if str(ws.get("id")) == str(target) or ws.get("name") == target:
                matched = ws
                break

        if not matched:
            print_bounded(f"Error: Workspace '{target}' not found.")
            return 1

        ws_name = matched.get("name", target)
        data["active"] = ws_name
        self._save(data)

        # Switch in tmux if available
        if shutil.which("tmux"):
            subprocess.run(["tmux", "switch-client", "-t", ws_name], capture_output=True, check=False)

        print_bounded(f"Switched to workspace '{ws_name}'.")
        return 0

    def close(self, target: str) -> int:
        """Close and terminate a workspace."""
        if not target:
            print_bounded("Error: Workspace name or ID required.")
            return 1

        data = self._load()
        workspaces: list[dict[str, Any]] = data.get("workspaces", [])

        matched_idx = -1
        for idx, ws in enumerate(workspaces):
            if str(ws.get("id")) == str(target) or ws.get("name") == target:
                matched_idx = idx
                break

        if matched_idx == -1:
            print_bounded(f"Error: Workspace '{target}' not found.")
            return 1

        if len(workspaces) <= 1:
            print_bounded("Error: Cannot close last remaining workspace.")
            return 1

        closing = workspaces.pop(matched_idx)
        closing_name = closing.get("name", target)

        # If we closed the active workspace, switch to first remaining
        if data.get("active") in (closing_name, str(closing.get("id"))):
            data["active"] = workspaces[0].get("name", "main")

        data["workspaces"] = workspaces
        self._save(data)

        # Terminate tmux session if available
        if shutil.which("tmux"):
            subprocess.run(["tmux", "kill-session", "-t", closing_name], capture_output=True, check=False)

        print_bounded(f"Closed workspace '{closing_name}'.")
        return 0


def cmd_workspace_dispatcher(args: list[str]) -> int:
    """Dispatch workspace / terminal subcommands."""
    mgr = WorkspaceManager()
    if not args:
        return mgr.list()

    verb = args[0].lower().strip()
    sub_args = args[1:]

    if verb in ("list", "ls"):
        return mgr.list()
    elif verb in ("new", "create", "add"):
        name = sub_args[0] if sub_args else None
        return mgr.new(name)
    elif verb in ("switch", "select", "attach"):
        if not sub_args:
            print_bounded("Error: Workspace name or ID required.")
            return 1
        return mgr.switch(sub_args[0])
    elif verb in ("close", "kill", "rm", "delete"):
        if not sub_args:
            print_bounded("Error: Workspace name or ID required.")
            return 1
        return mgr.close(sub_args[0])
    elif verb in ("help", "--help", "-h"):
        print_bounded("=== Help: wf workspace / terminal ===")
        print_bounded("Manage multi-terminal workspace sessions.")
        print_bounded("")
        print_bounded("Usage:")
        print_bounded("  wf workspace list")
        print_bounded("  wf workspace new [name]")
        print_bounded("  wf workspace switch <name|id>")
        print_bounded("  wf workspace close <name|id>")
        print_bounded("")
        print_bounded("Note: 'wf terminal' is an identical alias.")
        return 0

    print_bounded(f"Error: Unknown workspace command '{verb}'.")
    print_bounded("Valid commands: list, new, switch, close")
    return 1


# --- Main Help & Dispatcher -------------------------------------------------


def print_main_help() -> int:
    """Print top-level wf help <= 53 columns."""
    print_bounded("=== WhiskerFrame Cyberdeck (wf) ===")
    print_bounded("Unified control utility & offline manual.")
    print_bounded("")
    print_bounded("Usage:")
    print_bounded("  wf <subcommand> [args]")
    print_bounded("  wf help [subcommand]")
    print_bounded("  wf man [topic]")
    print_bounded("")
    print_bounded("Subcommands:")
    print_bounded("  help        Show command reference")
    print_bounded("  man         Offline manual & reference")
    print_bounded("  wifi        Manage Wi-Fi network")
    print_bounded("  demo        Launch demo sandbox")
    print_bounded("  demo art    Display artwork on CYD")
    print_bounded("  terminal    Manage terminal sessions")
    print_bounded("  workspace   Manage workspaces (alias)")
    print_bounded("")
    print_bounded("Manual topics: kb, wifi, demo, terminal, workspaces")
    print_bounded("For help on a command: wf help <subcommand>")
    return 0


def cmd_help(args: list[str]) -> int:
    """Handle help subcommand."""
    if not args:
        return print_main_help()

    target = args[0].lower().strip()
    if target in ("man", "manual"):
        print_bounded("=== Help: wf man ===")
        print_bounded("Display offline cyberdeck documentation.")
        print_bounded("")
        print_bounded("Usage:")
        print_bounded("  wf man [topic]")
        print_bounded("")
        print_bounded("Topics:")
        print_bounded("  kb          CardKB shortcuts & sticky Ctrl")
        print_bounded("  wifi        Wi-Fi network & 2.4GHz bounds")
        print_bounded("  demo        Sandbox limits & containment")
        print_bounded("  terminal    CYD display & protocol engine")
        print_bounded("  workspaces  Multi-terminal session manager")
        return 0
    elif target in ("wifi", "wlan"):
        print_bounded("=== Help: wf wifi ===")
        print_bounded("Manage cyberdeck Wi-Fi connections.")
        print_bounded("Reuses pi/bin/wifi (53-col screen optimized).")
        print_bounded("")
        print_bounded("Usage:")
        print_bounded("  wf wifi status")
        print_bounded("  wf wifi scan")
        print_bounded("  wf wifi join <N|SSID> [-p PASS] [--hidden]")
        print_bounded("  wf wifi forget <SSID>")
        return 0
    elif target in ("demo", "sandbox", "art"):
        print_bounded("=== Help: wf demo ===")
        print_bounded("Launch guest demonstration sandbox or art.")
        print_bounded("")
        print_bounded("Usage:")
        print_bounded("  wf demo          Launch sandbox & telemetry")
        print_bounded("  wf demo art      Display artwork gallery")
        return 0
    elif target in ("terminal", "workspace", "workspaces"):
        print_bounded("=== Help: wf workspace / terminal ===")
        print_bounded("Manage multi-terminal workspace sessions.")
        print_bounded("")
        print_bounded("Usage:")
        print_bounded("  wf workspace list")
        print_bounded("  wf workspace new [name]")
        print_bounded("  wf workspace switch <name|id>")
        print_bounded("  wf workspace close <name|id>")
        print_bounded("")
        print_bounded("Note: 'wf terminal' is an identical alias.")
        return 0

    print_bounded(f"Unknown command '{target}'. Showing main help:")
    print_bounded("")
    return print_main_help()


def main(argv: list[str] | None = None) -> int:
    """Main CLI entrypoint."""
    if argv is None:
        argv = sys.argv[1:]

    if not argv:
        return print_main_help()

    cmd = argv[0].lower().strip()
    sub_args = argv[1:]

    if cmd in ("-h", "--help", "help"):
        return cmd_help(sub_args)
    elif cmd in ("man", "manual"):
        return cmd_man(sub_args)
    elif cmd == "wifi":
        return cmd_wifi(sub_args)
    elif cmd == "demo":
        return cmd_demo(sub_args)
    elif cmd in ("terminal", "workspace", "workspaces"):
        return cmd_workspace_dispatcher(sub_args)
    else:
        print_bounded(f"Error: Unknown subcommand '{cmd}'.")
        print_bounded("Run 'wf help' for usage instructions.")
        return 1


if __name__ == "__main__":
    sys.exit(main())
