[Unit]
Description=Cyberdeck Reboot Splash Screen (brb :3)
DefaultDependencies=no
After=terminal.service
Before=shutdown.target umount.target final.target reboot.target
Conflicts=terminal.service

[Service]
Type=oneshot
ExecStart=/opt/cyd-display-link/pi/.venv/bin/python3 /opt/cyd-display-link/pi/bin/goodbye_hook --mode reboot
TimeoutSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=reboot.target
