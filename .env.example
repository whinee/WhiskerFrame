# Cyberdeck environment configuration.
#
# Copy to .env and edit for your setup:  cp .env.example .env
# .env is gitignored; .env.example is the committed template for new users.
# Consumed by scripts/pi_env_check.py (via scripts/config.py) and the justfile
# (set dotenv-load).

# Raspberry Pi host address.
PI_HOST=10.0.0.212

# SSH user on the Pi.
PI_USER=root

# Path to the SSH private key used to reach the Pi (referenced by path only).
DEFAULT_KEY_PATH=/home/lyra/.ssh/id_rsa

# Path to the uv-managed Pi host venv (where pyserial/whiskerframe are installed).
DEFAULT_VENV_PATH=/opt/cyd-display-link/pi/.venv
