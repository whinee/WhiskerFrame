## Example .env.komodo — flat, bash-only env for the Komodo 2.0 + FerretDB stack.
## Sourced by docker compose ONLY (never by python-dotenv / scripts/config.py).
##
## The real .env.komodo is generated on the Pi by the `komodo` Ansible role
## (mode 0600, secrets via `openssl rand -hex 32`, never committed). This file is
## a committed reference with PLACEHOLDER values only — do not put real secrets here.

# Image tag for ghcr.io/moghtech/komodo-core
COMPOSE_KOMODO_IMAGE_TAG=1.19.4
# Host path mounted into Core for backups (on the SSD).
COMPOSE_KOMODO_BACKUPS_PATH=/mnt/250GB-SSD/komodo-backups

# Database
KOMODO_DATABASE_USERNAME=komodo
KOMODO_DATABASE_PASSWORD=changeme-generate-with-openssl-rand-hex-32

# Core
TZ=Etc/UTC
KOMODO_HOST=http://localhost:9120
KOMODO_LOCAL_AUTH=true
KOMODO_INIT_ADMIN_USERNAME=admin
KOMODO_INIT_ADMIN_PASSWORD=changeme-generate-with-openssl-rand-hex-32
KOMODO_WEBHOOK_SECRET=changeme-generate-with-openssl-rand-hex-32
KOMODO_JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
KOMODO_DISABLE_USER_REGISTRATION=true
