## {{ ansible_managed }}
## Komodo 2.0 + FerretDB stack — flat, bash-only env (sourced by docker compose
## only; NEVER read by python-dotenv / scripts/config.py). Mode 0600. Secrets are
## generated once by the komodo role and are NOT committed. See .env.komodo.example.

# Image tag for ghcr.io/moghtech/komodo-core
COMPOSE_KOMODO_IMAGE_TAG={{ komodo_version }}
# Host path mounted into Core for backups (on the SSD).
COMPOSE_KOMODO_BACKUPS_PATH={{ komodo_backups_path }}

# Database (FerretDB speaks the Mongo wire protocol; Postgres/DocumentDB backs it).
KOMODO_DATABASE_USERNAME={{ komodo_db_username }}
KOMODO_DATABASE_PASSWORD={{ komodo_db_password }}

# Core
TZ=Etc/UTC
KOMODO_HOST={{ komodo_host_url }}
KOMODO_LOCAL_AUTH=true
KOMODO_INIT_ADMIN_USERNAME={{ komodo_admin_username }}
KOMODO_INIT_ADMIN_PASSWORD={{ komodo_admin_password }}
KOMODO_WEBHOOK_SECRET={{ komodo_webhook_secret }}
KOMODO_JWT_SECRET={{ komodo_jwt_secret }}
KOMODO_DISABLE_USER_REGISTRATION=true
