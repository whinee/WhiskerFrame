#!/usr/bin/env bash
# Managed by Ansible: guest_demo role
# Ephemeral home directory cleanup for guest on session logout.

GUEST_USER="{{ guest_user }}"
GUEST_HOME="{{ guest_home }}"

if [ "${PAM_USER:-}" = "$GUEST_USER" ] && [ "${PAM_TYPE:-}" = "close_session" ]; then
    logger -t guest-cleanup "Wiping ephemeral home directory for $GUEST_USER on session close"
    find "$GUEST_HOME" -mindepth 1 -delete 2>/dev/null || true
    cp -r /etc/skel/. "$GUEST_HOME/" 2>/dev/null || true
    chown -R "$GUEST_USER:$GUEST_USER" "$GUEST_HOME" 2>/dev/null || true
    chmod 0700 "$GUEST_HOME" 2>/dev/null || true
fi

if [ "${PAM_USER:-}" = "$GUEST_USER" ] && [ "${PAM_TYPE:-}" = "open_session" ]; then
    logger -t guest-login "Auto-starting demo setup for $GUEST_USER on PAM open_session"
    mkdir -p "$GUEST_HOME" 2>/dev/null || true
    if [ ! -f "$GUEST_HOME/.bashrc" ]; then
        cp -r /etc/skel/. "$GUEST_HOME/" 2>/dev/null || true
    fi
    if ! grep -q "CYD_DEMO_LAUNCHED" "$GUEST_HOME/.bashrc" 2>/dev/null; then
        echo 'if [ -z "${CYD_DEMO_LAUNCHED:-}" ]; then export CYD_DEMO_LAUNCHED=1; [ -n "$PS1" ] && { [ -x /usr/local/bin/wf ] && /usr/local/bin/wf demo || ([ -x /usr/local/bin/demo ] && /usr/local/bin/demo); }; fi' >> "$GUEST_HOME/.bashrc"
    fi
    chown -R "$GUEST_USER:$GUEST_USER" "$GUEST_HOME" 2>/dev/null || true
    chmod 0700 "$GUEST_HOME" 2>/dev/null || true
fi
